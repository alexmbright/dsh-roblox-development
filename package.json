{
  "name": "@alexturbo/dsh-roblox-development",
  "version": "1.5.2",
  "private": false,
  "type": "module",
  "description": "Self-provisioning Roblox toolchain with shared pinned binaries, workspace-local routine state, offline skills and explicit worker routes.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./routes.json": "./routes.json",
    "./routing": "./routing.js",
    "./workspace-runtime": "./workspace-runtime.js",
    "./toolchain": "./toolchain/plugin.js",
    "./toolchain/locale/*.json": "./locale/*.json",
    "./toolchain/icon": "./icon.svg",
    "./routing/locale/*.json": "./locale/*.json",
    "./routing/icon": "./icon.svg",
    "./workspace-runtime/locale/*.json": "./locale/*.json",
    "./workspace-runtime/icon": "./icon.svg",
    "./client": "./client.js",
    "./routing-controls": "./routing-controls.js",
    "./toolrun": "./toolrun.js",
    "./tools/check-visual-gate.mjs": "./tools/check-visual-gate.mjs",
    "./docs/VISUAL_GATE.md": "./docs/smaller-launch/VISUAL_GATE.md"
  },
  "files": [
    "index.js",
    "routing.js",
    "skill-policy.js",
    "visual-policy.js",
    "screenshots.js",
    "screenshot-bridge.js",
    "studio-ids.js",
    "http-bridge.js",
    "tools/check-visual-gate.mjs",
    "docs/smaller-launch/VISUAL_GATE.md",
    "coordination.js",
    "toolrun.js",
    "client.js",
    "routing-controls.js",
    "workspace-runtime.js",
    "workspace-env.js",
    "toolchain",
    "vendor",
    "plugin-index.json",
    "scripts/*.mjs",
    "cordis.patch.yml",
    "routes.json",
    "locale/*.json",
    "icon.svg",
    "skills/roblox-tiered-workflow/SKILL.md",
    "skills/roblox-tiered-workflow/references/*.md",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "tests/*.test.mjs"
  ],
  "dependencies": {
    "@chrrxs/robloxstudio-mcp": "3.4.4"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexmbright/dsh-roblox-development.git"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "node --experimental-test-isolation=none --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
